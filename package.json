{
    "name": "multipublish",
    "version": "0.1.3",
    "description": "自媒体、短视频多平台一键发布平台",
    "main": "dist-electron/main/index.js",
    "author": "whut09",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "typecheck": "tsc --noEmit",
        "test": "node --experimental-strip-types --test src/main/persistent-store.test.mjs src/main/ffmpeg.test.ts",
        "dist": "npm run build && electron-builder --win nsis"
    },
    "dependencies": {
        "@ant-design/icons": "^6.1.0",
        "antd": "^6.1.3",
        "dayjs": "^1.11.13",
        "ffmpeg-static": "^5.3.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "zustand": "^5.0.9"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "electron": "^39.2.6",
        "electron-builder": "^26.0.12",
        "electron-vite": "^4.0.1",
        "typescript": "^5.9.3",
        "vite": "^7.2.4"
    },
    "build": {
        "appId": "com.multipublish.desktop",
        "productName": "MultiPublish",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "package.json",
            "!node_modules/ffmpeg-static/ffmpeg.exe",
            "!node_modules/ffmpeg-static/ffmpeg.exe.*"
        ],
        "extraResources": [
            {
                "from": "node_modules/ffmpeg-static/ffmpeg.exe",
                "to": "ffmpeg/ffmpeg.exe"
            }
        ],
        "electronLanguages": [
            "zh-CN",
            "en-US"
        ],
        "compression": "maximum",
        "win": {
            "target": [
                "nsis"
            ],
            "artifactName": "MultiPublish-Setup-${version}.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        },
        "removePackageScripts": true
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/whut09/MultiPublish.git"
    },
    "homepage": "https://github.com/whut09/MultiPublish#readme"
}
